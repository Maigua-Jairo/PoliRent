# Entorno: development (devuelve el token de recuperacion en la respuesta) | production
NODE_ENV=development

# Puerto del servidor
PORT=4000

# Base de datos (MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/polirent

# JWT
JWT_SECRET=coloca_aqui_una_clave_secreta_larga
JWT_EXPIRES_IN=8h

# Origenes permitidos por CORS (URL del frontend, separadas por coma). Vacio = cualquier origen
FRONTEND_URL=http://localhost:5173

# Cloudinary (almacenamiento de imagenes). Sin estas variables la subida de imagenes queda deshabilitada
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dominio del correo institucional permitido para el registro (por defecto epn.edu.ec)
INSTITUTIONAL_EMAIL_DOMAIN=epn.edu.ec
